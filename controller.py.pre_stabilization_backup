# Simulation Helpers
# ---------------------------------------------------------------------------

def simulate_workload_transition(controller: EnergyAwareController,
                                 workloads: List[str] = None,
                 durations: List[float] = None):
    """Simulate workload transitions for testing the controller."""
    if workloads is None:
        workloads = ["light", "medium", "heavy", "medium", "light"]
    if durations is None:
        durations = [10, 15, 20, 15, 10]  # seconds per workload
    
    print(f"Simulating workload transition: {workloads}")
    print(f"Duration per workload: {durations}s")
    print()
    
    for workload, duration in zip(workloads, durations):
        if not controller.running:
            break
        
        # Simulate metrics for this workload
        cpu = simulate_cpu_utilization(workload)
        req_rate = simulate_request_rate(workload)
        latency = simulate_latency(workload, controller.current_replicas)
        
        # Update controller metrics (successful requests proportional to workload)
        sim_successful = int(5 + (duration / 5) * 10)  # scale with duration
        controller.update_metrics(cpu, req_rate, latency, successful=sim_successful, failed=0)
        
        # Print status
        status = controller.get_status()
        print(f"--- {workload.upper()} ---")
        print(f"  CPU: {status['avg_cpu']}% | Latency: {status['avg_latency_ms']}ms | "
              f"Replicas: {status['current_replicas']}")
        print(f"  Energy/req: {status['energy_per_request_estimate']:.3f} J | "
              f"SLA: {'Y' if status['sla_compliant'] else 'N'}")
        
        # Make scaling decision
        decision = controller.scaling_decision()
        if decision is not None:
            print(f"  -> Scaling: {'UP' if decision > 0 else 'DOWN'} by {abs(decision)} replica(s)")
        
        # Sleep for the duration (in real time, but scaled)
        time.sleep(min(duration, 3))  # Cap at 3s for demo
    
    print()


def simulate_cpu_utilization(workload: str = "medium") -> float:
    """Simulate CPU utilization based on workload profile."""
    profiles = {
        "light": 15.0,
        "medium": 50.0,
        "heavy": 85.0
    }
    return profiles.get(workload, 50.0)


def simulate_request_rate(workload: str = "medium") -> float:
    """Simulate request rate based on workload profile."""
    profiles = {
        "light": 5.0,
        "medium": 20.0,
        "heavy": 50.0
    }
    return profiles.get(workload, 20.0)


def simulate_latency(workload: str = "medium", replicas: int = 1) -> float:
    """Simulate average latency based on workload and replica count."""
    base_latencies = {"light": 30, "medium": 100, "heavy": 200}
    base = base_latencies.get(workload, 100)
    # More replicas = lower latency (roughly inverse proportion)
    return max(10, base / max(1, replicas / 2.0))


