@app.route("/status")
def status():
    """Service status endpoint."""
    return jsonify({
        "status": "operational",
        "workload": current_workload,
        "cpu_utilization": round(simulated_cpu_utilization, 1),
        "uptime_s": round(time.time() - app_start_time, 1),
        "flask_version": "2.x+",
        "mode": "simulation-based (Docker Desktop blocked in WSL2)",
        "experiment_count": len(EXPERIMENT_RESULTS) if EXPERIMENT_RESULTS else 0,
        "docker_status": "Desktop daemon blocked - WSL2 exit error 0x40010004",
        "kubernetes_status": "Not operational (Docker dependency required)"
    })


@app.route("/workload/change", methods=["POST"])
def change_workload():
    """Change the current workload profile."""
    global current_workload, workload_change_time
    data = request.get_json()
    if data and "profile" in data:
        profile = data["profile"]
        if profile in WORKLOAD_PROFILES:
            current_workload = profile
            workload_change_time = time.time()
            cpu, rate, latency = WORKLOAD_PROFILES[profile]
            simulated_cpu_utilization = cpu
            return jsonify({
                "status": f"Workload changed to {profile}",
                "cpu_percent": cpu,
                "request_rate": rate,
                "avg_latency_ms": latency
            })
    return jsonify({"error": "Invalid profile"}), 400


@app.route("/controller/status")
def controller_status():
    """Energy-aware controller status endpoint."""
    from controller import EnergyAwareController, estimate_power, estimate_energy_per_request
    
    # Create a default controller to get status
    config = {
        "min_replicas": 1,
        "max_replicas": 10,
        "target_cpu_util": 60,
        "scale_up_threshold": 80,
        "scale_down_threshold": 30,
        "hysteresis": 5,
        "cooldown_seconds": 60,
        "scale_change_cooldown": 30,
        "sla_latency_threshold_ms": 500,
        "energy_per_request_target": 1.0,
        "metric_samples": 20,
        "check_interval": 1,
    }
    controller = EnergyAwareController(config=config)
    status = controller.get_status()
    
    # Add experiment integration info
    status['experiment_integration'] = {
        "total_experiments": len(EXPERIMENT_RESULTS) if EXPERIMENT_RESULTS else 0,
        "modes_supported": ["static", "hpa", "energy_aware"],
        "workloads_supported": ["light", "medium", "heavy"],
        "energy_formula": "P = P_idle + (P_max - P_idle) * util/100 (estimated)",
        "energy_per_request_formula": "E_req = P * delta_t / N_req (estimated)"
    }
    
    return jsonify(status)


def get_cpu_utilization():
    """Get the current simulated CPU utilization."""
    return simulated_cpu_utilization


def get_workload():
    """Get the current workload profile."""
    return current_workload


# Background task to simulate workload transitions
def workload_transition_loop():
    """Periodically switch workload profiles to test autoscaling."""
    profiles = ['light', 'medium', 'heavy', 'medium', 'light']
    while True:
        try:
            for profile in profiles:
                current_workload = profile
                workload_change_time = time.time()
                # Update CPU simulation when workload changes
                cpu, rate, latency = WORKLOAD_PROFILES[profile]
                global simulated_cpu_utilization
                simulated_cpu_utilization = cpu
                time.sleep(random.uniform(3, 8))
        except Exception as e:
            print(f"Workload loop error: {e}")
            time.sleep(5)


# Start background workload transition thread
try:
    transition_thread = threading.Thread(target=workload_transition_loop, daemon=True)
    transition_thread.start()
except Exception as e:
    print(f"Could not start workload thread: {e}")


