#!/usr/bin/env python3
"""Energy-Aware Flask Microservice for Kubernetes Autoscaling Demonstration.

This microservice simulates realistic microservice behavior with:
- CPU-intensive and lightweight operations
- Request logging with timing
- Workload-aware endpoints
- Performance metrics collection
- Experiment data access
"""

from flask import Flask, jsonify, request
import time
import random
from datetime import datetime
import json
import os

app = Flask(__name__)

# Performance tracking
request_metrics = []
cpu_samples = []
start_time = time.time()
app_start_time = time.time()

# Simulated CPU utilization (percentage) - will be updated by endpoint handlers
simulated_cpu_utilization = 30.0  # Default baseline

# Workload profiles: (cpu_percent, request_rate_per_sec, avg_latency_ms)
WORKLOAD_PROFILES = {
    'light': (15, 5, 50),
    'medium': (50, 20, 100),
    'heavy': (85, 50, 200)
}

current_workload = 'light'
workload_change_time = time.time()

# Health check endpoint
@app.route("/health")
def health():
    """Health check endpoint."""
    import random as _random
    return jsonify({
        "status": "healthy",
        "workload": current_workload,
        "cpu_percent": round(simulated_cpu_utilization, 1),
        "memory_percent": round(_random.uniform(40, 80), 1),
    })

# Load experiment results from project root
PROJECT_ROOT = r'C:\Users\yuvaa\OneDrive\Desktop\Documents\Default Project'
EXPERIMENT_RESULTS = []
try:
    with open(os.path.join(PROJECT_ROOT, 'experiment_results.json'), 'r') as f:
        EXPERIMENT_RESULTS = json.load(f)
except FileNotFoundError:
    EXPERIMENT_RESULTS = []


@app.route("/")
def home():
    """Home endpoint."""
    uptime = time.time() - app_start_time
    return jsonify({
        "message": "Energy-Aware Flask Microservice is running",
        "workload": current_workload,
        "cpu_percent": round(simulated_cpu_utilization, 1),
        "uptime_s": round(uptime, 1),
        "replicas": 1  # Simulated
    })


@app.route("/info")
def info():
    """Information endpoint."""
    import random as _random
    return jsonify({
        "application": "Energy-Aware Autoscaling Framework",
        "framework": "Kubernetes-based microservices",
        "microservice": "Flask-based resource metrics endpoint",
        "workload": current_workload,
        "cpu_percent": round(simulated_cpu_utilization, 1),
        "memory_percent": round(_random.uniform(40, 80), 1),
        "supported_algorithms": [
            "EAES: Energy-Aware Elastic Scaling (proposed base paper algorithm)",
            "CPU-based HPA: Kubernetes default Horizontal Pod Autoscaler",
            "Static: Fixed replica provisioning"
        ],
        "energy_estimation": {
            "method": "CPU-utilization-based estimation (labeled as estimate, not direct measurement)",
            "formula": "E_per_request = (P_idle + (P_max - P_idle) * util/100) * delta_t / N_req",
            "note": "Energy values are estimates based on CPU utilization, not direct hardware power measurements"
        }
    })


@app.route("/workload/status")
def workload_status():
    """Get current workload profile status."""
    global current_workload, workload_change_time
    elapsed = time.time() - workload_change_time
    cpu, rate, latency = WORKLOAD_PROFILES[current_workload]
    return jsonify({
        "profile": current_workload,
        "cpu_percent": cpu,
        "request_rate": rate,
        "avg_latency_ms": latency,
        "seconds_at_profile": round(elapsed, 1),
        "uptime_seconds": round(time.time() - start_time, 1),
        "app_uptime_s": round(time.time() - app_start_time, 1)
    })


@app.route("/cpu/intensive")
def cpu_intensive():
    """CPU-intensive endpoint for generating load."""
    global simulated_cpu_utilization
    
    # Simulate CPU-intensive work duration based on workload
    profile = WORKLOAD_PROFILES[current_workload]
    base_cpu = profile[0]
    intensity_factor = random.uniform(0.8, 1.2)
    simulated_cpu_utilization = min(95, base_cpu * intensity_factor)
    
    # Simulate computation time
    compute_time = random.uniform(0.05, 0.2)
    _ = sum(i * i for i in range(1000 * int(compute_time * 10)))
    
    # Record metrics
    cpu_sample = {
        "timestamp": time.time(),
        "cpu_percent": simulated_cpu_utilization,
        "endpoint": "/cpu/intensive",
        "workload": current_workload
    }
    cpu_samples.append(cpu_sample)
    if len(cpu_samples) > 50:
        cpu_samples.pop(0)
    
    # Record request metric
    request_metrics.append({
        "timestamp": time.time(),
        "endpoint": "/cpu/intensive",
        "cpu_percent": simulated_cpu_utilization,
        "response_time_ms": round(compute_time * 1000, 2),
        "workload": current_workload
    })
    if len(request_metrics) > 100:
        request_metrics.pop(0)
    
    return jsonify({
        "status": "CPU-intensive operation completed",
        "cpu_percent": round(simulated_cpu_utilization, 1),
        "computation_time_ms": round(compute_time * 1000, 2),
        "workload": current_workload,
        "sla_violation": simulated_cpu_utilization > 80  # SLA check
    })


@app.route("/cpu/light")
def cpu_light():
    """Lightweight endpoint for normal operations."""
    global simulated_cpu_utilization
    
    # Minimal computation
    _ = 42 + 42
    
    # Slight increase in CPU during light operation
    simulated_cpu_utilization = max(10, simulated_cpu_utilization - 5)
    
    # Record metrics
    cpu_sample = {
        "timestamp": time.time(),
        "cpu_percent": simulated_cpu_utilization,
        "endpoint": "/cpu/light",
        "workload": current_workload
    }
    cpu_samples.append(cpu_sample)
    if len(cpu_samples) > 50:
        cpu_samples.pop(0)
    
    # Record request metric
    request_metrics.append({
        "timestamp": time.time(),
        "endpoint": "/cpu/light",
        "cpu_percent": simulated_cpu_utilization,
        "response_time_ms": 1.0,
        "workload": current_workload
    })
    if len(request_metrics) > 100:
        request_metrics.pop(0)
    
    return jsonify({
        "status": "Lightweight operation completed",
        "cpu_percent": round(simulated_cpu_utilization, 1),
        "workload": current_workload
    })


@app.route("/metrics")
def metrics():
    """Prometheus-compatible metrics endpoint."""
    cpu_avg = sum(s['cpu_percent'] for s in cpu_samples) / max(len(cpu_samples), 1) if cpu_samples else simulated_cpu_utilization
    
    # Calculate request rate from recent metrics
    recent = [m for m in request_metrics if time.time() - m['timestamp'] < 10]
    request_rate = len(recent) / max(1, (time.time() - recent[0]['timestamp'])) * 60 if recent else 0
    
    # Memory simulation (since psutil not available)
    import random as _random
    mem_util = _random.uniform(40, 80)
    
    lines = [
        f'# HELP flask_cpu_utilization_current Current CPU utilization percentage',
        f'# TYPE flask_cpu_utilization_current gauge',
        f'flask_cpu_utilization_current {cpu_avg:.1f}',
        f'# HELP flask_memory_utilization_current Current memory utilization percentage',
        f'# TYPE flask_memory_utilization_current gauge',
        f'flask_memory_utilization_current {mem_util:.1f}',
        f'# HELP flask_requests_total Total number of requests',
        f'# TYPE flask_requests_total counter',
        f'flask_requests_total {len(request_metrics)}',
        f'# HELP flask_request_rate_current Current request rate (req/s)',
        f'# TYPE flask_request_rate_current gauge',
        f'flask_request_rate_current {request_rate:.1f}',
        f'# HELP flask_cpu_utilization_average Average CPU utilization',
        f'# TYPE flask_cpu_utilization_average gauge',
        f'flask_cpu_utilization_average {round(sum(s["cpu_percent"] for s in cpu_samples) / max(len(cpu_samples), 1), 1)}',
    ]
    
    return '\n'.join(lines), 200, {'Content-Type': 'text/plain; version=0.0.4; charset=utf-8'}


@app.route("/api/v1/experiments")
def experiments():
    """Experiment data endpoint - returns all experiment results."""
    if EXPERIMENT_RESULTS is None or not EXPERIMENT_RESULTS:
        return jsonify({
            "error": "No experiment data available",
            "total_experiments": 0
        }), 404
    
    mode_counts = Counter(r.get('mode') for r in EXPERIMENT_RESULTS)
    total_energy = sum(r.get('avg_energy_per_request', 0) for r in EXPERIMENT_RESULTS if r.get('avg_energy_per_request'))
    avg_energy = total_energy / len(EXPERIMENT_RESULTS) if EXPERIMENT_RESULTS else 0
    
    experiment_list = []
    for i, r in enumerate(EXPERIMENT_RESULTS):
        exp = {
            "id": i + 1,
            "mode": r.get('mode'),
            "workload": r.get('workload'),
            "repetition": r.get('repetition'),
            "average_replicas": r.get('average_replicas'),
            "avg_cpu_percent": r.get('avg_cpu'),
            "avg_energy_per_request_j": r.get('avg_energy_per_request'),
            "avg_latency_ms": r.get('avg_latency_ms'),
            "total_sla_violations": r.get('total_sla_violations'),
            "total_samples": r.get('total_samples')
        }
        experiment_list.append(exp)
    
    return jsonify({
        "total_experiments": len(EXPERIMENT_RESULTS),
        "modes": dict(mode_counts),
        "average_energy_per_request_j": round(avg_energy, 4),
        "experiments": experiment_list
    })


